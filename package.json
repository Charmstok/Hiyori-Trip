{
  "name": "hiyori-trip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-only Japan travel planner. Plan thoughtfully, travel freely.",
  "scripts": {
    "dev": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs --preview",
    "build": "tsc -b && vite build",
    "preview": "node server/index.mjs --preview",
    "format": "prettier --write src server index.html vite.config.ts tsconfig.json package.json README.md THIRD_PARTY_NOTICES.md"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.1",
    "@react-pdf/renderer": "^4.9.0",
    "d3-geo": "^3.1.1",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
