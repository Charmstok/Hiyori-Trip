{
  "name": "hiyori-trip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-only Japan travel planner. Plan thoughtfully, travel freely.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "start": "vite --host 127.0.0.1 --port 4317 --strictPort",
